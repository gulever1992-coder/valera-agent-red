+for box in [(8,209,75,216),(169,222,240,230),(90,237,157,242)]:
+    d.ellipse(box,fill='#183a46',outline='#47656a')
+    x1,y1,x2,y2=box; d.line((x1+8,(y1+y2)//2,x2-9,(y1+y2)//2),fill='#a26533')
+# steam clouds in pixel clusters
+for cx,cy in [(71,93),(193,90),(160,70)]:
+    for _ in range(18):
+        x=cx+random.randrange(-12,13); y=cy-random.randrange(0,25)
