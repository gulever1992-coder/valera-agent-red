+    h=random.randrange(8,22); d.rectangle((x,62-h,x+random.randrange(14,29),62),fill='#263943')
+    d.rectangle((x+2,63-h,x+random.randrange(11,23),64-h),fill='#4d6166')
+# cranes behind dock
+def crane(x,y,flip=1):
