+    d.line((x+2*flip,y,x+15*flip,104),fill=hi,width=1)
+    d.line((x+4*flip,y,x+15*flip,104),fill='#15262d',width=2)
+    d.line((x,y+4,x+48*flip,y+4),fill=edge,width=3)
+    d.line((x+2*flip,y+7,x+44*flip,y+7),fill=col,width=2)
+    d.line((x+37*flip,y+8,x+37*flip,79),fill='#1e3037',width=1)
+    d.line((x+37*flip,79,x+43*flip,79),fill='#c87931',width=2)
+crane(20,15,1); crane(219,25,-1); crane(160,7,1)
