+from PIL import Image, ImageDraw
+import random
+
+random.seed(18)
+W=256
+im=Image.new('RGB',(W,W),'#13232d'); d=ImageDraw.Draw(im)
+# dawn sky bands
+d.rectangle((0,0,255,58), fill='#71828b')
+d.rectangle((0,32,255,66), fill='#5c6e78')
+for _ in range(90):
+    x=random.randrange(W); y=random.randrange(2,82)
+    c=random.choice(['#8fa0a5','#455966','#6b7d84','#a3adb0'])
+    d.rectangle((x,y,x+random.randrange(1,9),y+random.randrange(1,2)),fill=c)
+# distant blocks and roofline
+for x in range(-8,260,random.randrange(15,25)):
+    h=random.randrange(8,22); d.rectangle((x,62-h,x+random.randrange(14,29),62),fill='#263943')
+    d.rectangle((x+2,63-h,x+random.randrange(11,23),64-h),fill='#4d6166')
+# cranes behind dock
+def crane(x,y,flip=1):
+    col='#26383e'; edge='#547078'; hi='#718b8c'
+    d.polygon([(x,y),(x+5*flip,y),(x+18*flip,104),(x+12*flip,104)],fill=col)
+    d.line((x+2*flip,y,x+15*flip,104),fill=hi,width=1)
+    d.line((x+4*flip,y,x+15*flip,104),fill='#15262d',width=2)
+    d.line((x,y+4,x+48*flip,y+4),fill=edge,width=3)
+    d.line((x+2*flip,y+7,x+44*flip,y+7),fill=col,width=2)
+    d.line((x+37*flip,y+8,x+37*flip,79),fill='#1e3037',width=1)
+    d.line((x+37*flip,79,x+43*flip,79),fill='#c87931',width=2)
+crane(20,15,1); crane(219,25,-1); crane(160,7,1)
+# dock walls / open gate
+d.polygon([(0,83),(56,73),(72,160),(0,187)],fill='#263b43')
+d.polygon([(255,83),(202,73),(184,160),(255,187)],fill='#263b43')
+for side in [0,1]:
+    for i in range(18):
+        x=(random.randrange(0,67) if side==0 else random.randrange(191,256)); y=random.randrange(86,175)
+        d.rectangle((x,y,x+random.randrange(1,5),y+1),fill=random.choice(['#405b60','#182c34','#5d7374']))
+# steel gate posts framing entrance, no signage
+for x in (17,226):
+    d.rectangle((x,55,x+11,176),fill='#17282e'); d.rectangle((x+2,58,x+4,173),fill='#49636a')
+    d.rectangle((x-2,53,x+13,58),fill='#243a40'); d.rectangle((x-4,174,x+15,180),fill='#16262d')
