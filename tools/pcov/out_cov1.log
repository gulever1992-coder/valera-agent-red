+d.polygon([(179,108),(198,119),(181,130)],fill='#142229')
+d.rectangle((126,80,147,99),fill='#1d3036'); d.rectangle((130,77,143,84),fill='#31454a')
+for x in range(90,178,12): d.line((x,113,x+6,132),fill='#2b4146')
+d.line((66,143,193,143),fill='#567078',width=1)
+# warm work lights and glow
+for x,y in [(55,80),(202,84),(119,75),(150,78)]:
+    d.rectangle((x-2,y-2,x+2,y+2),fill='#d06e2c');d.point((x,y),fill='#fff0a0')
+    for r,c in [(7,'#805233'),(4,'#bd6b30')]: d.rectangle((x-r,y-r,x+r,y+r),outline=c)
+# wet concrete foreground
+d.polygon([(0,166),(255,166),(255,255),(0,255)],fill='#1c3038')
+for y in [179,197,220,246]: d.line((0,y,255,y),fill='#29434b')
+for x in range(-40,310,20): d.line((128,164,x,256),fill='#29424a')
+for _ in range(80):
+    x=random.randrange(256); y=random.randrange(168,255)
+    c=random.choice(['#36545a','#27464e','#4e6568','#172a32'])
+    d.rectangle((x,y,x+random.randrange(1,7),y+random.choice([0,1])),fill=c)
